#cloud-config

package_update: true
package_upgrade: true
timezone: ${timezone}

hostname: ${hostname}
manage_etc_hosts: true

users:
  - default
  - name: ${username}
    shell: /bin/bash
    groups:
      - sudo
    sudo: ALL=(ALL) NOPASSWD:ALL
    passwd: ${user_password_hash}
    ssh_authorized_keys:
      - ${ssh_public_key}

packages:
  # proxmox integration
  - qemu-guest-agent

  # Package repositories and API access
  - curl
  - ca-certificates
  - gnupg

  # Data and certificate inspection
  - jq
  - openssl

  # Basic network diagnostics
  - netcat-openbsd 
  - iputils-ping
  - bind9-dnsutils
  - iproute2
  - iptables 

  # Kubernetes and container networking diagnostics
  - conntrack
  - socat 
  - ethtool

  # General troublshooting and
  - lsof
  - tcpdump
  - bash-completion

  # Optional 
  - vim
  - htop
  
write_files:
  - path: /etc/modules-load.d/k8s.conf
    permissions: "0644"
    content: |
      overlay
      br_netfilter

  - path: /etc/sysctl.d/99-kubernetes.conf
    permissions: "0644"
    content: |
      net.bridge.bridge-nf-call-ip6tables = 1
      net.bridge.bridge-nf-call-iptables = 1
      net.ipv4.ip_forward = 1

runcmd:
  - modprobe overlay
  - modprobe br_netfilter
  - systemctl enable --now containerd
  - swapoff -a
  - sed -ri '/\sswap\s/s/^([^#].*)$/#\1/' /etc/fstab
  - sysctl --system