#cloud-config

package_update: true
package_upgrade: true
timezone: ${timezone}

hostname: ${hostname}
manage_etc_hosts: true

users:
  - default
  - name: ${username}
    shell: /bin/bash
    groups:
      - sudo
    sudo: ALL=(ALL) NOPASSWD:ALL
    passwd: ${user_password_hash}
    ssh_authorized_keys:
      - ${ssh_public_key}

packages:
  - qemu-guest-agent
  - containerd
  - curl
  - ca-certificates
  - vim
  - htop
  - bash-completion

write_files:
  - path: /etc/modules-load.d/k8s.conf
    permissions: "0644"
    content: |
      overlay
      br_netfilter

  - path: /etc/sysctl.d/99-kubernetes.conf
    permissions: "0644"
    content: |
      net.bridge.bridge-nf-call-ip6tables = 1
      net.bridge.bridge-nf-call-iptables = 1
      net.ipv4.ip_forward = 1

runcmd:
  - modprobe overlay
  - modprobe br_netfilter
  - systemctl enable --now containerd
  - swapoff -a
  - sed -ri '/\sswap\s/s/^([^#].*)$/#\1/' /etc/fstab
  - sysctl --system